# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# `android/` É versionada (ADR-014): o manifest carrega permissões do timer de
# descanso e o cleartext de debug, que não sobrevivem a um `flutter create .`.
# O resto do que fica de fora (local.properties, gradlew, keystores) já está
# em `android/.gitignore`, que veio do template.
/android/.kotlin/
/android/build/
/android/app/build/

# Demais pastas de plataforma — geradas com `flutter create .`, não versionadas
# (ver app/README.md).
/ios/
/web/
/linux/
/macos/
/windows/
