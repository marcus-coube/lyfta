# assessment — copie para .env e ajuste (nunca commitar o .env real).
# Ver backend/.env.example para a descrição completa de cada variável.

PORT=8083
# Role lyfta_app (sem BYPASSRLS, criada pela migration 0004_app_role) — RLS só
# tem efeito de verdade com uma role sem privilégio de superusuário/bypass.
DATABASE_URL=postgres://lyfta_app:lyfta_app_dev@localhost:5432/lyfta_assessment?sslmode=disable

# CORS: origens separadas por vírgula (ex.: http://localhost:5173,https://app.lyfta.com).
CORS_ORIGINS=http://localhost:*

# JWT EdDSA (ed25519) — só a PÚBLICA: o assessment valida tokens, quem assina é
# o identity (ADR-013 §4). Mesma chave gerada por backend/scripts/gen-keys.sh.
JWT_PUBLIC_KEY=

# Service-to-service (header X-Internal-Token).
INTERNAL_TOKEN=dev-internal-token

APP_ENV=development

# S3-compatible para fotos de evolução: entra na P2.3 junto com o presign de
# mídia (a P2.2 é só esqueleto + schema, sem endpoint de upload ainda).
