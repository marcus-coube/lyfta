# comms — copie para .env e ajuste (nunca commitar o .env real).
# Ver backend/.env.example para a descrição completa de cada variável.

PORT=8084
# Role lyfta_app (sem BYPASSRLS, criada pela migration 0006_app_role) — RLS só
# tem efeito de verdade com uma role sem privilégio de superusuário/bypass.
DATABASE_URL=postgres://lyfta_app:lyfta_app_dev@localhost:5432/lyfta_comms?sslmode=disable

# CORS: origens separadas por vírgula (ex.: http://localhost:5173,https://app.lyfta.com).
CORS_ORIGINS=http://localhost:*

# JWT EdDSA (ed25519) — só a PÚBLICA: o comms valida tokens, quem assina é
# o identity (ADR-013 §4). Mesma chave gerada por backend/scripts/gen-keys.sh.
JWT_PUBLIC_KEY=

# Service-to-service (header X-Internal-Token).
INTERNAL_TOKEN=dev-internal-token

APP_ENV=development

# Redis (P3.1): fan-out de eventos do WebSocket entre instâncias (P3.2). Mesmo
# Redis do docker-compose.yml (backend/README.md).
REDIS_URL=redis://localhost:6379/0

# S3-compatible para imagem de chat (P3.2): mesmo MinIO do docker-compose,
# mesmas credenciais de dev do workout (P1.2)/assessment (P2.3).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=lyfta-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_PATH_STYLE=true
# Vazia: a imagem é servida por GET assinado (bucket privado, o caso do MinIO
# de dev). Preenchida: bucket público atrás de CDN/domínio próprio.
S3_PUBLIC_BASE_URL=

# Push FCM (P3.4): credencial da service account do projeto Firebase
# (Console → Configurações do projeto → Contas de serviço → Gerar nova chave
# privada). Aceita as duas formas: caminho do arquivo .json (dev — o arquivo
# fica fora do repo) ou o JSON inteiro inline (CI/produção, começa com "{").
# O project_id vem de dentro do JSON — não há variável separada.
# Projeto de dev atual: lyfta-a3bd3. Vazia é válida: o serviço sobe com push
# desligado (loga um aviso na subida), chat e check-in continuam funcionando.
FCM_CREDENTIALS_JSON=

# M2M com o workout (ADR-013 §4/§5): onde o job diário de "treino pendente"
# (P3.4) busca GET /internal/v1/pending-students (X-Internal-Token acima).
WORKOUT_BASE_URL=http://localhost:8082

# Timezone do job diário "treino pendente" (P3.4) — resolve "hoje" e "18h
# locais" do plano. Não há timezone por tenant ainda (dívida técnica, ver
# Notas de execução da P3-comunicacao.md); todo tenant usa este fuso por ora.
NOTIFICATION_TIMEZONE=America/Sao_Paulo
