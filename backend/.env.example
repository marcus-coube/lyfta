# Variáveis comuns dos serviços Go (ver backend/README.md).
# Copie para .env em cada serviço (backend/<svc>/.env) e ajuste — nunca commitar
# o .env real.

# Porta HTTP do serviço (uma por serviço: identity 8081, workout 8082,
# assessment 8083, comms 8084).
PORT=8081

# Postgres local da máquina — um banco por serviço (ADR-013). Troque o nome do
# banco conforme o serviço (lyfta_identity, lyfta_workout, lyfta_assessment,
# lyfta_comms).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lyfta_identity?sslmode=disable

# Par de chaves EdDSA (ed25519) para JWT — gerar com backend/scripts/gen-keys.sh.
# JWT_PRIVATE_KEY só é necessária no identity (quem assina); os demais serviços
# só precisam da pública para validar.
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=

# Token compartilhado para chamadas service-to-service (header X-Internal-Token).
INTERNAL_TOKEN=dev-internal-token

# S3-compatible (MinIO no dev, ver docker-compose.yml). Usado por
# workout/assessment/comms para mídia via presigned URLs. Migrar para S3/R2
# real é trocar endpoint e credenciais (ADR-009), sem mudar código.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=lyfta-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Bucket por caminho (MinIO, endpoint de conta do R2) ou por subdomínio (false).
S3_USE_PATH_STYLE=true
# Domínio público do bucket/CDN. Vazio: a mídia é servida por GET assinado.
S3_PUBLIC_BASE_URL=

# E-mail transacional (Resend) — usado só pelo identity (convites, reset de senha).
RESEND_API_KEY=
MAIL_FROM=Lyfta <no-reply@lyfta.app>

# Base do app Flutter web — usada só pelo identity para montar o link de
# convite/reset de senha (APP_URL/#/invite?token=..., .../#/reset-password?token=...).
APP_URL=http://localhost:5173

# Redis — usado pelo comms (chat WS, filas) e pelo identity (limite de
# tentativas dos endpoints públicos, ADR-002 §2c; vazio no identity = contadores
# em memória, só para dev — obrigatório com APP_ENV=production).
REDIS_URL=redis://localhost:6379/0

# identity: "true" só atrás de proxy reverso — o IP do limite de tentativas
# passa a ser o último do X-Forwarded-For. Sem proxy, deixar vazio (forjável).
TRUST_PROXY=

# Push FCM (P3.4) — usado só pelo comms. Credencial da service account do
# projeto Firebase (Console → Configurações do projeto → Contas de serviço →
# Gerar nova chave privada), como caminho do arquivo .json (dev) ou como o
# JSON inline (CI/produção, começa com "{"). O project_id vem de dentro do
# JSON. Exige a Firebase Cloud Messaging API (V1) habilitada no projeto.
# Vazia é válida: o comms sobe com push desligado (loga um aviso), chat e
# check-in continuam funcionando normalmente.
FCM_CREDENTIALS_JSON=

# Job diário "treino pendente" (P3.4) — usado só pelo comms. Onde encontrar o
# workout para o M2M (GET /internal/v1/pending-students, X-Internal-Token).
WORKOUT_BASE_URL=http://localhost:8082

# Timezone usado pelo job diário do comms para resolver "hoje" e "18h locais"
# (plano P3.4). Não há timezone por tenant ainda (dívida técnica, ver Notas de
# execução da P3-comunicacao.md) — todo tenant usa este mesmo fuso por ora.
NOTIFICATION_TIMEZONE=America/Sao_Paulo

# Relato de erros — Sentry/GlitchTip (P4.6, ADR-009 §5), todos os serviços.
# DSN vazio = desligado: nada é enviado. `APP_ENV` vira o `environment` do
# evento; SENTRY_RELEASE (opcional) marca a versão. Evento leva só
# user_id/tenant_id, nunca e-mail, nome, corpo ou query (ADR-008).
SENTRY_DSN=
SENTRY_RELEASE=
