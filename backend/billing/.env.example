# billing — copie para .env e ajuste (nunca commitar o .env real).
# Ver backend/.env.example para a descrição completa de cada variável.

PORT=8085
# Role lyfta_app (sem BYPASSRLS, criada pela migration 0004_app_role) — RLS só
# tem efeito de verdade com uma role sem privilégio de superusuário/bypass.
DATABASE_URL=postgres://lyfta_app:lyfta_app_dev@localhost:5432/lyfta_billing?sslmode=disable

# CORS: origens separadas por vírgula.
CORS_ORIGINS=http://localhost:*

# JWT EdDSA (ed25519) — só a PÚBLICA: o billing valida tokens, quem assina é o
# identity (ADR-013 §4). Mesma chave gerada por backend/scripts/gen-keys.sh.
JWT_PUBLIC_KEY=

# Service-to-service (header X-Internal-Token).
INTERNAL_TOKEN=dev-internal-token

APP_ENV=development

# identity: vínculo professor↔aluno (ADR-016), dados do aluno e configuração
# do tenant (ADR-017 §3), por M2M com INTERNAL_TOKEN.
IDENTITY_URL=http://localhost:8081
COACH_LINK_CACHE_TTL=30s
# Cache do fuso e do modo de acesso do coach ao financeiro (ADR-017 §3).
TENANT_SETTINGS_CACHE_TTL=30s

# Relato de erros (ADR-009 §5); vazio = desligado.
SENTRY_DSN=
