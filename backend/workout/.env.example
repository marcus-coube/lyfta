# workout — copie para .env e ajuste (nunca commitar o .env real).
# Ver backend/.env.example para a descrição completa de cada variável.

PORT=8082
# Role lyfta_app (sem BYPASSRLS, criada pela migration 0013_app_role) — RLS só
# tem efeito de verdade com uma role sem privilégio de superusuário/bypass.
DATABASE_URL=postgres://lyfta_app:lyfta_app_dev@localhost:5432/lyfta_workout?sslmode=disable

# CORS: origens separadas por vírgula (ex.: http://localhost:5173,https://app.lyfta.com).
CORS_ORIGINS=http://localhost:*

# JWT EdDSA (ed25519) — só a PÚBLICA: o workout valida tokens, quem assina é o
# identity (ADR-013 §4). Mesma chave gerada por backend/scripts/gen-keys.sh.
JWT_PUBLIC_KEY=

# Service-to-service (header X-Internal-Token).
INTERNAL_TOKEN=dev-internal-token

# S3-compatible (MinIO no dev) para mídia de exercício — usado a partir do P1.2.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=lyfta-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

APP_ENV=development
