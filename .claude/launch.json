{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app-web",
      "runtimeExecutable": "flutter",
      "runtimeArgs": ["run", "-d", "chrome", "--web-port", "5678"],
      "port": 5678,
      "cwd": "app"
    },
    {
      "name": "app-web-release",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "5700", "--directory", "build/web"],
      "port": 5700,
      "cwd": "app"
    },
    {
      "name": "identity",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "set -a; . ./.env; set +a; go run ./cmd/api"],
      "port": 8081,
      "url": "http://localhost:8081",
      "cwd": "backend/identity"
    },
    {
      "name": "workout",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "set -a; . ./.env; set +a; go run ./cmd/api"],
      "port": 8082,
      "url": "http://localhost:8082",
      "cwd": "backend/workout"
    },
    {
      "name": "assessment",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "set -a; . ./.env; set +a; go run ./cmd/api"],
      "port": 8083,
      "url": "http://localhost:8083",
      "cwd": "backend/assessment"
    }
  ]
}
