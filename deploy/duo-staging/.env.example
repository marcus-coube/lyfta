# duo-staging — copiar para .env na VPS (/opt/duo-staging/.env, chmod 600).
# Nunca commitar o .env real. Senhas: `openssl rand -hex 32` (hex evita
# problema de escape em URL/YAML).

# Domínio base: os hosts são app., identity., workout., assessment., comms.,
# billing. e media. + DUO_BASE (DNS-only no Cloudflare → IP da VPS).
DUO_BASE=staging.duotraining.app
PUBLIC_SCHEME=https
# Vazio na VPS. Local: ":8080" (gateway publicado pelo override).
PUBLIC_PORT=

# Tag das imagens no GHCR (staging = último build; sha-<commit> = rollback).
TAG=staging

# Dados do stack
POSTGRES_PASSWORD=
DUO_APP_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=duo-staging
MINIO_ROOT_PASSWORD=

# Auth — par EdDSA de backend/scripts/gen-keys.sh (PEM numa linha, com \n).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
INTERNAL_TOKEN=

# E-mail (D2). Vazio = convite/reset só no log do identity.
RESEND_API_KEY=
MAIL_FROM=DÜO <no-reply@duotraining.app>
TERMS_VERSION=2026-11-v4

# Opcional
SENTRY_DSN=
SENTRY_RELEASE=
